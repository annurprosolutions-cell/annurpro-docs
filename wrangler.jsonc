{
  // Satu Worker: hos fail app (static assets) + API /api/* dan webhook /bcl/*.
  // Rujuk docs/02-TRD.md §9 dan README.md "Langkah pemilik".
  "name": "annur-invoice",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/bcl/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "annur-invoice",
      // Database ID D1 annur-invoice
      "database_id": "4182b7f6-d6d6-451e-8a00-564364c6be88"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "933747272196-5ub5jst04ff6e3b21ou8muouvvlmfgae.apps.googleusercontent.com",
    "ALLOWED_ORIGINS": "",
    "OWNER_EMAILS": "annurprosolutions@gmail.com",
    "TRIAL_CREDITS": "50",
    "CREDITS_PER_DOC": "5",
    "GRACE_DAYS": "7",
    "EDIT_WINDOW_HOURS": "24",
    "BUY_URL_SUB": "https://annurprosolutions1.bcl.my/form/invoice-system",
    "BUY_URL_PACK": "",
    "BCL_FORM_ID": "20718",
    "BCL_API_URL": "https://api.bcl.my/v1",
    "YEARLY_MIN_AMOUNT": "150",
    "PACKS": "{\"10\":110,\"20\":230,\"50\":600}",
    "PRICE_MONTH": "20",
    "PRICE_YEAR": "200",
    "BCL_ACCEPT_TEST": "0"
  }
  // Rahsia (set dalam dashboard, JANGAN tulis di sini): BCL_API_TOKEN, BCL_WEBHOOK_KEY, ADMIN_TOKEN
}
